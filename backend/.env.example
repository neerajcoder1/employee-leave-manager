# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL Connection)
# Provide the direct connection string (e.g. postgres://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres)
# Or connection pooling string for production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_leave_db

# Security
JWT_SECRET=supersecretjwtkeychangeinproduction123!
JWT_EXPIRES_IN="X"
